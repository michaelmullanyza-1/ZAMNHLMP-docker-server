# Copy to .env and adjust. Do not commit .env.

# Base folder for server data and configuration. Must be an absolute path.
# Created subfolders: $SERVER_PATH/data (game files) and $SERVER_PATH/config.
SERVER_PATH=/path/to/game-server

# User and group that own the files and run the game (non-root).
PUID=1000
PGID=1000

# Public game port (UDP and TCP).
SERVER_PORT=27015

# Gameplay defaults.
START_MAP=crossfire
MAX_PLAYERS=16

# Container name shown in Docker and Portainer.
CONTAINER_NAME=zamn-server

# Check Steam for updates on every container start. Set to 0 to disable.
UPDATE_ON_START=1

# Give up on a slow Steam download after this many seconds and start the
# already-installed release instead.
UPDATE_TIMEOUT_SECONDS=600

# SteamCMD image. Pinned by digest in docker-compose.yml by default.
# Override with a tag or digest, for example:
# STEAMCMD_IMAGE=cm2network/steamcmd:root
# STEAMCMD_IMAGE=gameservermanagers/steamcmd:latest

# Dedicated server AppID on Steam. The game AppID (3416640) is detected
# automatically from the installed mod and does not need to be set here.
SERVER_APPID=3807180